{
	"name": "palettable",
	"version": "0.0.1",
	"description": "Palettable monorepo — headless palette primitives + heads",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.25.0",
	"author": "François Marie De Mey <eeddow@gmail.com>",
	"license": "AGPL-3.0-only",
	"homepage": "https://github.com/eddow/palettable#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/eddow/palettable.git"
	},
	"bugs": {
		"url": "https://github.com/eddow/palettable/issues"
	},
	"keywords": [
		"palette",
		"toolbar",
		"headless",
		"command-palette",
		"vanilla"
	],
	"scripts": {
		"dev:vanilla": "pnpm --filter @palettable/vanilla dev -- --port 4174 --strictPort",
		"dev:vue": "pnpm --filter @palettable/vue dev -- --port 4175 --strictPort",
		"build": "pnpm --filter @palettable/core build && pnpm --filter @palettable/vanilla build",
		"check": "pnpm --recursive check",
		"test": "pnpm --recursive test",
		"test:e2e": "playwright test",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"lint:unsafe": "biome check --write . --unsafe",
		"format": "biome format --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@playwright/test": "^1.62.1"
	}
}
