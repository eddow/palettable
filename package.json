{
	"name": "palettable",
	"version": "0.0.1",
	"description": "Palettable monorepo — headless palette primitives + heads",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.25.0",
	"scripts": {
		"dev": "pnpm --filter @palettable/svelte dev",
		"dev:svelte": "pnpm --filter @palettable/svelte dev",
		"dev:vanilla": "pnpm --filter @palettable/vanilla dev -- --port 4174 --strictPort",
		"build": "pnpm --filter @palettable/core build && pnpm --filter @palettable/vanilla build && pnpm --filter @palettable/svelte build",
		"build:core": "pnpm --filter @palettable/core build",
		"build:vanilla": "pnpm --filter @palettable/vanilla build",
		"build:svelte": "pnpm --filter @palettable/svelte build",
		"preview:svelte": "pnpm --filter @palettable/svelte preview -- --port 4173 --strictPort",
		"preview:vanilla": "pnpm --filter @palettable/vanilla preview",
		"check": "pnpm --recursive check",
		"check:core": "pnpm --filter @palettable/core check",
		"check:vanilla": "pnpm --filter @palettable/vanilla check",
		"check:svelte": "pnpm --filter @palettable/svelte check",
		"test": "pnpm --recursive test",
		"test:core": "pnpm --filter @palettable/core test",
		"test:vanilla": "pnpm --filter @palettable/vanilla test",
		"test:svelte": "pnpm --filter @palettable/svelte test",
		"test:e2e": "playwright test",
		"test:e2e:svelte": "playwright test --project=svelte",
		"test:e2e:vanilla": "playwright test --project=vanilla",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"lint:unsafe": "biome check --write . --unsafe",
		"format": "biome format --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@playwright/test": "^1.62.1"
	}
}
