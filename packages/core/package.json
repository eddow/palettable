{
	"name": "@palettable/core",
	"version": "0.0.1",
	"description": "Palettable core — headless palette primitives (vanilla TS, framework-agnostic, rolled-up)",
	"private": true,
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"unpkg": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "rollup -c",
		"check": "tsc --noEmit -p ./tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"clean": "rimraf dist"
	},
	"devDependencies": {
		"@rollup/plugin-node-resolve": "^15.3.1",
		"@rollup/plugin-typescript": "^11.1.6",
		"rimraf": "^6.1.3",
		"rollup": "^4.59.0",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"vitest": "^5.0.0"
	}
}
