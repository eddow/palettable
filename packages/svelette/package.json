{
	"name": "@palettable/svelte",
	"version": "0.0.1",
	"description": "A Svelte 5 re-implementation of @sursaut/ui (headless UI primitives + palette)",
	"private": true,
	"author": "François Marie De Mey <eeddow@gmail.com>",
	"license": "AGPL-3.0-only",
	"homepage": "https://github.com/eddow/palettable#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/eddow/palettable.git",
		"directory": "packages/svelte"
	},
	"bugs": {
		"url": "https://github.com/eddow/palettable/issues"
	},
	"keywords": [
		"palette",
		"toolbar",
		"headless",
		"command-palette",
		"svelte",
		"sveltekit",
		"svelte5"
	],
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@palettable/core": "workspace:*",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^24.0.0",
		"jsdom": "^30.0.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.2.2",
		"vitest": "^5.0.0"
	}
}
