{
	"name": "@palettable/vanilla",
	"version": "0.0.1",
	"description": "Palettable vanilla-DOM adapter — headless core with plain DOM rendering (rolled-up)",
	"private": true,
	"author": "François Marie De Mey <eeddow@gmail.com>",
	"license": "AGPL-3.0-only",
	"homepage": "https://github.com/eddow/palettable#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/eddow/palettable.git",
		"directory": "packages/vanilla"
	},
	"bugs": {
		"url": "https://github.com/eddow/palettable/issues"
	},
	"keywords": [
		"palette",
		"toolbar",
		"headless",
		"command-palette",
		"vanilla"
	],
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"unpkg": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "vite",
		"build": "rollup -c",
		"check": "tsc --noEmit -p ./tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"preview": "vite preview",
		"clean": "rimraf dist"
	},
	"dependencies": {
		"@palettable/core": "workspace:*"
	},
	"devDependencies": {
		"@rollup/plugin-node-resolve": "^15.3.1",
		"@rollup/plugin-typescript": "^11.1.6",
		"@types/node": "^24.0.0",
		"jsdom": "^30.0.1",
		"rimraf": "^6.1.3",
		"rollup": "^4.59.0",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"vite": "^8.2.2",
		"vitest": "^5.0.0"
	}
}
