{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM"],
		"strict": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"noEmit": true,
		"paths": {
			"@palettable/core": ["../core/src/index.ts"],
			"@palettable/vanilla": ["./src/index.ts"]
		}
	},
	"include": [
		"src/**/*.ts",
		"demo/**/*.ts",
		"vite.config.ts",
		"vitest.config.ts"
	],
	"exclude": ["dist", "node_modules"]
}
